# Image MultiModel .gitignore

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.installed.cfg
*.egg

# ── Virtual Environment ──────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── IDE ─────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.catpaw/
.trae/

# AI 工具本地状态（记忆/计划，仅本地保留，不上远程）
.workbuddy-ai/
.zcode/

# AI 规范（仅本地保留，不上远程，家族统一约定）
AGENTS.md

# 仅本地容器：内部说明、agent 上下文、实验记录、纯历史（§13.1 唯一 ignore 容器）
# 本仓为私有仓：迁移前已跟踪的 local/ 下文件（如 local/agents/GOTCHAS.md）随仓保留，
# 新增的 local/ 内容不入库。
/local/

# 内部/本地规则（仅本地保留，不上远程，避免暴露本地信息）
LOCAL_RULES.md

# ── Testing ─────────────────────────────────────────────────
.pytest_cache/
.pytest_tmp/
.coverage
htmlcov/

# ── Data & Output ────────────────────────────────────────────
data/*.db
data/*.db-wal
data/*.db-shm
data/uploads/
data/cache/
# 训练编排薄层的运行时目录：状态 JSON / job.yaml / stdout.log / loss_log.db / 训练产物
# （由 app/integrated_app/training 在运行时生成，含大体积 LoRA 与 optimizer，禁止入库）
data/training/
# 权重 SHA256 清单（TOFU 基线，机器特定——权重经 junction 指向本机模型库，勿入库）
data/weight_manifest.json
# 便携模型库（junction 指向本机 ComfyUI 模型目录；正式分发包由 pack_portable.ps1 复制实体文件）
pretrained_models/
# api_token bootstrap 生成的本机令牌（见 security/auth_bootstrap.py）
.api_token
outputs/
logs/
backups/

# 本地独享文档（治理/分析报告，仅本地保留、不上远程，2026-09-02）
docs/*
# 运维 runbook 必须随仓库分发（alerts.py 的告警 runbook 链接指向本目录，
# v2.9 评估运维稳定性 P1-1：原先整目录被忽略导致克隆即失）
!docs/runbooks/

# ── Model Files (大文件不提交) ──────────────────────────────
*.safetensors
*.pt
*.bin
*.ckpt
*.gguf

# ── OS ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── SSL ─────────────────────────────────────────────────────
bin/cert.pem
bin/key.pem

# ── .env（P1-3: 敏感配置不提交）──────────────────────────────
.env

# ── Temporary files（§5.2 清理）─────────────────────────────────────
*.txt
!requirements.txt
!requirements-lock.txt
!examples/prompts.txt
!PRD.md
!MASTER_PLAN.md
!WEBAPP_GUIDE.md
!TEST_AUDIT_REPORT.md
!AUDIT_REPORT_2.0.md
!REMAINING_TASKS_REPORT.md
.trash/
pytest_out*.txt
gen*.txt
fp_out*.txt

# CI 修复交接日志（旧本地账本，不入库）：内容已迁到随仓库分发的
# docs/runbooks/ci_fix_ledger.md。保留忽略是为了不再产生第二份事实来源——勿再往这里登记。
FIX_LOG.md

# ── Checkpoints ─────────────────────────────────────────────
data/checkpoints/

# ── Docker ──────────────────────────────────────────────────
docker-compose.override.yml

# Auto-captured screenshots (output of tests/capture-screenshots.js)
/screenshots/

# 水印签名密钥（仅本机，严禁入库/随包分发）
.watermark_key

# 清单签名密钥（任务书 P0：签发机私钥，严禁入库/随包分发；公钥 manifest_signing_public_key.pem 随仓库入库）
data/.manifest_signing_key
data/.imm_secret
data/watermark_audit.log

# ── Hypothesis property-based testing ───────────────────────
.hypothesis/

# ── Jupyter notebooks checkpoints ───────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Coverage and profiling (扩展) ────────────────────────────
.coverage.*
.coverage.xml
coverage.xml
htmlcov/
cover/
coverage/
*.prof
prof/*.prof

# ── Benchmark results ────────────────────────────────────────
perf/results/*.json
perf/results/*.html
!perf/results/.gitkeep

# ── Temporary build artifacts ────────────────────────────────
*.pyc
__pycache__/
dist/
build/
*.egg-info/

# Cloned learning repos (research reference only, not part of project)
references/

# Vendored Comfy inference kernel (独立内核项目源码，维持为其独立 git 仓库，不并入本仓库)
comfy_kernel/

.git.backup/

# 自进化协议细化文档（仅本地保留，不并入仓库）
docs/agents/

# Agent 工作区（WorkBuddy 会话记忆，仅本地保留）
.workbuddy/

# .git 损坏恢复现场备份（保留在磁盘，永不入库）
.git.corrupted-*/

# 数据治理对账工具的历史库备份（reconcile_db_disk --apply 产物）
data/*.bak

# 前端测试产物（依赖与渲染快照）
tests/node_modules/
tests/frontend/_rendered/
data/config_audit.log

# --- 2026-09-07 守卫暴露的遗漏（缓存目录）---
.ruff_cache/
.mypy_cache/

# --- auto-tidy: 运行时产物自动补齐 (auto) ---
.benchmarks/

desktop/src-tauri/tauri.key

# 发布构建产物（增量包/分卷）
release/packages/
desktop/src-tauri/target/

# 安装器本地编译产物（不入库）
desktop/installer/ImageMultiModel.exe
desktop/installer/ImageMultiModel-Setup-v*.exe

# 学习/报告备忘（本地，不入库，2026-09-12）
学习报告任务备忘_20260912.md

# AI IDE 本地工作目录（仅本地保留，不上远程）
# 例外（2026-10-06 设立，2026-10-16 恢复）：.qoder/rules/ 是随仓库分发的 agent 基线指令层——
# 根 AGENTS.md 与 docs/agents/ 均为本地保留，干净克隆 / CI 检出里只有这份基线可读。
.qoder/*
!.qoder/rules/
# 根目录健康文件由组织级仓库提供（self-purify 检查②），本地不入库
CONTRIBUTING.md
CODE_OF_CONDUCT.md
SUPPORT.md

# --- 敏感信息防泄露（Git 版本控制安全工程与防泄露最佳实践指南 v1.1 第二章/第八章，2026-10-07）---
# 说明：本仓已有 .env / data/*.db / logs/ / bin/cert.pem 等按路径的忽略规则，这里只补「任何目录」的兜底。
# 公钥 app/integrated_app/security/manifest_signing_public_key.pem 须随仓库入库，故不写 *.pem / *.key 通配。
.env.*
!.env.example
!.env.sample
!.env.template
*.env
service-account.json
*.p12
*.pfx
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
credentials.json
credentials.yaml
credentials.yml
secrets.json
secrets.yaml
secrets.yml
*.sqlite
*.sqlite3
*.db
*.log
server.pem
server.key
.aws/
.gcloud/

# 根目录健康文件由组织级仓库提供（self-purify 检查②），本地不入库
CONTRIBUTING.md
CODE_OF_CONDUCT.md
SUPPORT.md
